{
    "battery": {
        "events": {
            "on-discharging-critical": "sh -c 'level=$(cat /sys/class/power_supply/BAT0/capacity); notify-send -a Battery -u critical \"Critical battery\" \"Battery is at ${level}%. Connect a charger.\"'",
            "on-discharging-warning": "sh -c 'level=$(cat /sys/class/power_supply/BAT0/capacity); notify-send -a Battery -u normal \"Low battery\" \"Battery is at ${level}%.\"'"
        },
        "format": "BAT {capacity}%",
        "format-charging": "BAT {capacity}% +",
        "format-full": "BAT 100%",
        "interval": 30,
        "states": {
            "critical": 12,
            "warning": 25
        }
    },
    "clock": {
        "format": "{:%a %d/%m/%Y (%b)  %H:%M:%S}",
        "interval": 1
    },
    "group/essentials": {
        "modules": [
            "pulseaudio",
            "battery",
            "custom/keyboard-layout",
            "custom/clipboard"
        ],
        "orientation": "horizontal"
    },
    "height": 26,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-top": 0,
    "modules-center": [
        "clock"
    ],
    "modules-left": [
        "river/tags",
        "river/window"
    ],
    "modules-right": [
        "group/essentials",
        "custom/window-controls",
        "tray",
        "custom/system-menu"
    ],
    "reload_style_on_change": true,
    "spacing": 0,
    "tray": {
        "icon-size": 14,
        "spacing": 5
    }
}
