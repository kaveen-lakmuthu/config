#!/bin/sh

# Manual start/stop times keep this predictable without a location service.
night_stop='06:00'
night_start='18:00'
temperature='4000'
transition='1800'

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/river-control-center/generated/power-idle.conf"
if [ -r "$config_file" ]; then
    . "$config_file"
    night_start=${RCC_NIGHT_LIGHT_START:-$night_start}
    night_stop=${RCC_NIGHT_LIGHT_STOP:-$night_stop}
fi

runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
pid_file="$runtime_dir/river-wlsunset.pid"

is_running() {
    [ -r "$pid_file" ] || return 1
    pid=$(sed -n '1p' "$pid_file")
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null &&
        [ "$(cat "/proc/$pid/comm" 2>/dev/null)" = 'wlsunset' ]
}

start() {
    is_running && return 0
    wlsunset \
        -S "$night_stop" \
        -s "$night_start" \
        -d "$transition" \
        -t "$temperature" \
        -T 6500 \
        >/dev/null 2>&1 &
    printf '%s\n' "$!" > "$pid_file"
}

stop() {
    if is_running; then
        kill "$pid" 2>/dev/null || true
    fi
    rm -f "$pid_file"
}

status() {
    if is_running; then
        printf '%s\n' '{"text":"NIGHT","class":"active","tooltip":"Night light enabled · click to disable"}'
    else
        printf '%s\n' '{"text":"DAY","class":"inactive","tooltip":"Night light disabled · click to enable"}'
    fi
}

case ${1:-status} in
    start)  start ;;
    stop)   stop ;;
    toggle)
        if is_running; then
            stop
        else
            start
        fi
        ;;
    reload)
        if is_running; then
            stop
            start
        fi
        ;;
    status) status ;;
    *)
        printf 'usage: %s {start|stop|toggle|reload|status}\n' "$0" >&2
        exit 2
        ;;
esac
