{
  "include": "../river-control-center/generated/waybar-settings.json",
  "layer": "top",
  "position": "top",

  "river/window": {
    "max-length": 50
  },

  "custom/clipboard": {
    "format": "CLIP",
    "tooltip-format": "Clipboard history",
    "on-click": "$HOME/.config/waybar/scripts/desktop-panel.py clipboard"
  },

  "custom/keyboard-layout": {
    "exec": "$HOME/.config/waybar/scripts/keyboard-layout status",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/keyboard-layout toggle"
  },

  "custom/window-controls": {
    "exec": "$HOME/.config/waybar/scripts/window-controls.py --status",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/window-controls.py"
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "Muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "custom/system-menu": {
    "exec": "$HOME/.config/waybar/scripts/quick-settings.py --status",
    "return-type": "json",
    "interval": 2,
    "on-click": "$HOME/.config/waybar/scripts/quick-settings.py"
  }
}
