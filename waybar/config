{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 0,
  "margin-top": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "margin-left": 0,

  "modules-left": [
    "river/tags",
    "river/window"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "group/essentials",
    "custom/window-controls",
    "tray",
    "custom/system-menu"
  ],

  "group/essentials": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "battery",
      "custom/keyboard-layout",
      "custom/clipboard"
    ]
  },

  "river/tags": {
    "num-tags": 9,
    "on-scroll-up": "$HOME/.config/river/bin/river-cycle-tags previous 9",
    "on-scroll-down": "$HOME/.config/river/bin/river-cycle-tags next 9",
    "smooth-scrolling-threshold": 1.0
  },

  "river/window": {
    "max-length": 50
  },

  "clock": {
    "format": "{:%a %d/%m/%Y (%b)  %H:%M:%S}",
    "interval": 1
  },

  "custom/clipboard": {
    "format": "CLIP",
    "tooltip-format": "Clipboard history",
    "on-click": "$HOME/.config/waybar/scripts/desktop-panel.py clipboard"
  },

  "custom/keyboard-layout": {
    "exec": "$HOME/.config/waybar/scripts/keyboard-layout status",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/keyboard-layout toggle"
  },

  "custom/window-controls": {
    "exec": "$HOME/.config/waybar/scripts/window-controls.py --status",
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.config/waybar/scripts/window-controls.py"
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "Muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "battery": {
    "interval": 30,
    "format": "BAT {capacity}%",
    "format-charging": "BAT {capacity}% +",
    "format-full": "BAT 100%",
    "states": {
      "warning": 25,
      "critical": 12
    },
    "events": {
      "on-discharging-warning": "sh -c 'level=$(cat /sys/class/power_supply/BAT0/capacity); notify-send -a Battery -u normal \"Low battery\" \"Battery is at ${level}%.\"'",
      "on-discharging-critical": "sh -c 'level=$(cat /sys/class/power_supply/BAT0/capacity); notify-send -a Battery -u critical \"Critical battery\" \"Battery is at ${level}%. Connect a charger.\"'"
    }
  },

  "tray": {
    "icon-size": 14,
    "spacing": 5
  },

  "custom/system-menu": {
    "exec": "$HOME/.config/waybar/scripts/quick-settings.py --status",
    "return-type": "json",
    "interval": 2,
    "on-click": "$HOME/.config/waybar/scripts/quick-settings.py"
  }
}
