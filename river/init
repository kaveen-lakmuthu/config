#!/bin/sh

# =============================================================================
# River Classic Daily Driver
# =============================================================================

# -----------------------------------------------------------------------------
# Session environment
# -----------------------------------------------------------------------------

export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_DESKTOP=river
export XDG_SESSION_TYPE=wayland

export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME=kde
export QT_STYLE_OVERRIDE=Breeze
export GTK_THEME=Breeze-Dark
export MOZ_ENABLE_WAYLAND=1

# Graphical launchers do not read .zshrc. Make user-installed applications
# available to Fuzzel and to processes activated through D-Bus/systemd.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) PATH="$HOME/.local/bin:$PATH" ;;
esac
export PATH

# Values written by River Control Center. Defaults keep the session usable if
# the generated file is missing or has not been created yet.
RCC_BASE='#08111F'
RCC_SURFACE='#101C2C'
RCC_SECONDARY_SURFACE='#17283D'
RCC_TEXT='#EEF2F6'
RCC_MUTED_TEXT='#A8B4C3'
RCC_ACCENT='#D6AE4A'
RCC_SECONDARY_ACCENT='#4C83C3'
RCC_HIGHLIGHT='#79AFC7'
RCC_URGENT='#B94747'
RCC_SUCCESS='#5F9C83'
RCC_BORDER_UNFOCUSED='#27374A'
RCC_BORDER_WIDTH=2
RCC_VIEW_PADDING=0
RCC_OUTER_PADDING=0
RCC_DEFAULT_POWER_PROFILE='balanced'
RCC_MAIN_RATIO=0.60
RCC_MAIN_COUNT=1
RCC_MAIN_POSITION='left'
RCC_ATTACH_MODE='bottom'
RCC_FOCUS_POLICY='mode-aware'
RCC_DEFAULT_LAYOUT_MODE='tiled'
RCC_TAG_COUNT=9
RCC_AUTOSTART_WAYBAR=true
RCC_AUTOSTART_MAKO=true
RCC_AUTOSTART_KANSHI=true
RCC_AUTOSTART_FUSUMA=true
RCC_AUTOSTART_SWAYIDLE=true

RCC_THEME="$HOME/.config/river-control-center/generated/river-theme.sh"
if [ -r "$RCC_THEME" ]; then
    . "$RCC_THEME"
fi

RCC_POWER_IDLE="$HOME/.config/river-control-center/generated/power-idle.conf"
if [ -r "$RCC_POWER_IDLE" ]; then
    . "$RCC_POWER_IDLE"
fi

RCC_WINDOW_SETTINGS="$HOME/.config/river-control-center/generated/window-management.conf"
if [ -r "$RCC_WINDOW_SETTINGS" ]; then
    . "$RCC_WINDOW_SETTINGS"
fi

RCC_SESSION_STARTUP="$HOME/.config/river-control-center/generated/session-startup.conf"
if [ -r "$RCC_SESSION_STARTUP" ]; then
    . "$RCC_SESSION_STARTUP"
fi

dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE \
    QT_QPA_PLATFORM \
    QT_QPA_PLATFORMTHEME \
    QT_STYLE_OVERRIDE \
    GTK_THEME \
    PATH

systemctl --user import-environment \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE \
    QT_QPA_PLATFORM \
    QT_QPA_PLATFORMTHEME \
    QT_STYLE_OVERRIDE \
    GTK_THEME \
    PATH

# Tell systemd that River is the active graphical session. This target pulls
# in graphical-session.target; do not start graphical-session.target directly.
systemctl --user start river-session.target

# -----------------------------------------------------------------------------
# Background services
# -----------------------------------------------------------------------------

# KDE polkit authentication agent
/usr/libexec/kf6/polkit-kde-authentication-agent-1 &

# Dynamic output profiles
if [ "$RCC_AUTOSTART_KANSHI" = true ]; then
    kanshi &
fi

# Warm the display after sunset. The Waybar control can toggle this process.
$HOME/.config/waybar/scripts/night-light start

# Select the configured River-session default without affecting Plasma's
# service management.
$HOME/.config/waybar/scripts/power-profile set \
    "$RCC_DEFAULT_POWER_PROFILE" >/dev/null 2>&1 || true

"$HOME/.config/river/scripts/start-background"
if [ "$RCC_AUTOSTART_MAKO" = true ]; then
    mako &
fi
if [ "$RCC_AUTOSTART_WAYBAR" = true ]; then
    waybar &
fi
nm-applet --indicator &
blueman-applet &
udiskie --tray &
if [ "$RCC_AUTOSTART_FUSUMA" = true ]; then
    $HOME/.config/river/scripts/start-fusuma start
fi

# Clipboard history
wl-paste --type text --watch cliphist store &
wl-paste --type image --watch cliphist store &

# Idle / lock. The helper owns a PID file so live settings changes restart
# only this River session's swayidle process.
if [ "$RCC_AUTOSTART_SWAYIDLE" = true ]; then
    $HOME/.config/river/scripts/start-swayidle start
fi

# -----------------------------------------------------------------------------
# Appearance
# -----------------------------------------------------------------------------

riverctl background-color "0x${RCC_BASE#\#}"
riverctl border-color-focused "0x${RCC_ACCENT#\#}"
riverctl border-color-unfocused "0x${RCC_BORDER_UNFOCUSED#\#}"
riverctl border-width "$RCC_BORDER_WIDTH"

# Keep the existing master in place; append new views to the stack.
riverctl default-attach-mode "$RCC_ATTACH_MODE"

# -----------------------------------------------------------------------------
# Keyboard / input
# -----------------------------------------------------------------------------

# Apply the touchpad, keyboard repeat, enabled layouts and Compose key written
# by River Control Center. The keyboard helper keeps the shortcut and Waybar
# indicator in sync.
$HOME/.config/river/scripts/apply-input

# All keyboard, pointer, media and tag mappings are generated by River Control
# Center. Keeping them outside this file makes individual bindings editable.
RCC_KEYBINDINGS="$HOME/.config/river-control-center/generated/keybindings.sh"
if [ -r "$RCC_KEYBINDINGS" ]; then
    . "$RCC_KEYBINDINGS"
fi

# -----------------------------------------------------------------------------
# Window rules
# -----------------------------------------------------------------------------

RCC_WINDOW_RULES="$HOME/.config/river-control-center/generated/window-rules.sh"
if [ -r "$RCC_WINDOW_RULES" ]; then
    . "$RCC_WINDOW_RULES"
fi

# -----------------------------------------------------------------------------
# Default layout
# -----------------------------------------------------------------------------

if [ "$RCC_DEFAULT_LAYOUT_MODE" = 'floating' ]; then
    riverctl default-layout floating
else
    riverctl default-layout rivertile
fi

# Tile edge-to-edge; River's borders separate adjacent views without
# wasting pixels around the outside of the usable area.
rivertile \
    -view-padding "$RCC_VIEW_PADDING" \
    -outer-padding "$RCC_OUTER_PADDING" \
    -main-ratio "$RCC_MAIN_RATIO" \
    -main-count "$RCC_MAIN_COUNT" \
    -main-location "$RCC_MAIN_POSITION" &

$HOME/.config/waybar/scripts/layout-mode set "$RCC_DEFAULT_LAYOUT_MODE"
