#!/bin/sh

# =============================================================================
# River Classic Daily Driver
# =============================================================================

# -----------------------------------------------------------------------------
# Session environment
# -----------------------------------------------------------------------------

export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_DESKTOP=river
export XDG_SESSION_TYPE=wayland

export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME=kde
export QT_STYLE_OVERRIDE=Breeze
export GTK_THEME=Breeze-Dark
export MOZ_ENABLE_WAYLAND=1

dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE \
    QT_QPA_PLATFORM \
    QT_QPA_PLATFORMTHEME \
    QT_STYLE_OVERRIDE \
    GTK_THEME

systemctl --user import-environment \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE \
    QT_QPA_PLATFORM \
    QT_QPA_PLATFORMTHEME \
    QT_STYLE_OVERRIDE \
    GTK_THEME

# Tell systemd that River is the active graphical session. This target pulls
# in graphical-session.target; do not start graphical-session.target directly.
systemctl --user start river-session.target

# -----------------------------------------------------------------------------
# Background services
# -----------------------------------------------------------------------------

# KDE polkit authentication agent
/usr/libexec/kf6/polkit-kde-authentication-agent-1 &

# Dynamic output profiles
kanshi &

# Warm the display after sunset. The Waybar control can toggle this process.
$HOME/.config/waybar/scripts/night-light start

swaybg -c '#08111F' &
mako &
waybar &
nm-applet --indicator &
blueman-applet &
udiskie --tray &
fusuma &

# Clipboard history
wl-paste --type text --watch cliphist store &
wl-paste --type image --watch cliphist store &

# Idle / lock
swayidle -w \
    timeout 600 '$HOME/.config/river/scripts/lock-screen' \
    timeout 900 'wlopm --off \*' \
        resume 'wlopm --on \*' \
    timeout 1800 '$HOME/.config/river/scripts/idle-suspend battery' \
    timeout 3600 '$HOME/.config/river/scripts/idle-suspend always' \
    before-sleep '$HOME/.config/river/scripts/lock-screen' &

# -----------------------------------------------------------------------------
# Appearance
# -----------------------------------------------------------------------------

riverctl background-color 0x08111F
riverctl border-color-focused 0xD6AE4A
riverctl border-color-unfocused 0x27374A
riverctl border-width 2

# Keep the existing master in place; append new views to the stack.
riverctl default-attach-mode bottom

# -----------------------------------------------------------------------------
# Keyboard / input
# -----------------------------------------------------------------------------

riverctl set-repeat 50 300
riverctl focus-follows-cursor normal

# English (US) and Sinhala (phonetic). The shared helper keeps the
# keyboard shortcut and Waybar indicator in sync.
$HOME/.config/waybar/scripts/keyboard-layout set us
riverctl map normal Alt Shift_L spawn \
    '$HOME/.config/waybar/scripts/keyboard-layout toggle'
riverctl map normal Alt Shift_R spawn \
    '$HOME/.config/waybar/scripts/keyboard-layout toggle'
riverctl map normal Shift Alt_L spawn \
    '$HOME/.config/waybar/scripts/keyboard-layout toggle'
riverctl map normal Shift Alt_R spawn \
    '$HOME/.config/waybar/scripts/keyboard-layout toggle'

# Touchpad
riverctl input '*Touchpad' tap enabled
riverctl input '*Touchpad' tap-button-map left-right-middle
riverctl input '*Touchpad' click-method clickfinger
riverctl input '*Touchpad' scroll-method two-finger
riverctl input '*Touchpad' drag enabled
riverctl input '*Touchpad' drag-lock disabled
riverctl input '*Touchpad' disable-while-typing enabled
riverctl input '*Touchpad' natural-scroll enabled
riverctl input '*Touchpad' pointer-accel 0.1

# -----------------------------------------------------------------------------
# Core applications
# -----------------------------------------------------------------------------

riverctl map normal Super Return spawn foot
riverctl map normal Super D spawn fuzzel
riverctl map normal Super T spawn dolphin
# Match Brave Origin's KDE launch environment so it keeps using the existing
# profile and KWallet-backed Secret Portal key.
riverctl map normal Super B spawn ~/.local/bin/brave-kwallet

riverctl map normal Super Q close
riverctl map normal Super+Shift E exit

# -----------------------------------------------------------------------------
# Focus
# -----------------------------------------------------------------------------

riverctl map normal Super J focus-view next
riverctl map normal Super K focus-view previous

riverctl map normal Super+Shift J swap next
riverctl map normal Super+Shift K swap previous

riverctl map normal Super Period focus-output next
riverctl map normal Super Comma focus-output previous

riverctl map normal Super+Shift Period send-to-output next
riverctl map normal Super+Shift Comma send-to-output previous

# Promote focused view to main position
riverctl map normal Super Z zoom

# -----------------------------------------------------------------------------
# Layout control
# -----------------------------------------------------------------------------

riverctl map normal Super H \
    send-layout-cmd rivertile "main-ratio -0.05"

riverctl map normal Super L \
    send-layout-cmd rivertile "main-ratio +0.05"

riverctl map normal Super+Shift H \
    send-layout-cmd rivertile "main-count +1"

riverctl map normal Super+Shift L \
    send-layout-cmd rivertile "main-count -1"

riverctl map normal Super Up \
    send-layout-cmd rivertile "main-location top"

riverctl map normal Super Right \
    send-layout-cmd rivertile "main-location right"

riverctl map normal Super Down \
    send-layout-cmd rivertile "main-location bottom"

riverctl map normal Super Left \
    send-layout-cmd rivertile "main-location left"

# -----------------------------------------------------------------------------
# Floating / fullscreen
# -----------------------------------------------------------------------------

riverctl map normal Super Space toggle-float
riverctl map normal Super+Shift Space spawn \
    '$HOME/.config/waybar/scripts/layout-mode toggle'
riverctl map normal Super F toggle-fullscreen

# -----------------------------------------------------------------------------
# Mouse
# -----------------------------------------------------------------------------

riverctl map-pointer normal Super BTN_LEFT move-view
riverctl map-pointer normal Super BTN_RIGHT resize-view
riverctl map-pointer normal Super BTN_MIDDLE toggle-float

# -----------------------------------------------------------------------------
# Tags 1-9
# -----------------------------------------------------------------------------

for i in $(seq 1 9)
do
    tags=$((1 << ($i - 1)))

    riverctl map normal Super $i \
        set-focused-tags $tags

    riverctl map normal Super+Shift $i \
        set-view-tags $tags

    riverctl map normal Super+Control $i \
        toggle-focused-tags $tags

    riverctl map normal Super+Shift+Control $i \
        toggle-view-tags $tags
done

all_tags=$(((1 << 32) - 1))

riverctl map normal Super 0 \
    set-focused-tags $all_tags

riverctl map normal Super+Shift 0 \
    set-view-tags $all_tags

# -----------------------------------------------------------------------------
# Clipboard
# -----------------------------------------------------------------------------

riverctl map normal Super V spawn \
    '$HOME/.config/waybar/scripts/desktop-panel.py clipboard'

# -----------------------------------------------------------------------------
# Audio
# -----------------------------------------------------------------------------

for mode in normal locked
do
    riverctl map $mode None XF86AudioRaiseVolume spawn \
        'wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+'

    riverctl map $mode None XF86AudioLowerVolume spawn \
        'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'

    riverctl map $mode None XF86AudioMute spawn \
        'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'

    riverctl map $mode None XF86AudioMicMute spawn \
        'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'

    riverctl map $mode None XF86AudioPlay spawn \
        'playerctl play-pause'

    riverctl map $mode None XF86AudioNext spawn \
        'playerctl next'

    riverctl map $mode None XF86AudioPrev spawn \
        'playerctl previous'

    riverctl map $mode None XF86MonBrightnessUp spawn \
        '$HOME/.config/river/scripts/brightness up'

    riverctl map $mode None XF86MonBrightnessDown spawn \
        '$HOME/.config/river/scripts/brightness down'
done

# -----------------------------------------------------------------------------
# Screenshots
# -----------------------------------------------------------------------------

riverctl map normal None Print spawn \
    '$HOME/.config/river/scripts/screenshot full'

riverctl map normal Super Print spawn \
    '$HOME/.config/river/scripts/screenshot region'

riverctl map normal Super+Shift Print spawn \
    '$HOME/.config/river/scripts/screenshot annotate'

# -----------------------------------------------------------------------------
# Lock
# -----------------------------------------------------------------------------

riverctl map normal Super+Control L spawn \
    '$HOME/.config/river/scripts/lock-screen'

# -----------------------------------------------------------------------------
# Floating rules
# -----------------------------------------------------------------------------

riverctl rule-add -app-id 'pavucontrol' float
riverctl rule-add -app-id 'blueman-manager' float
riverctl rule-add -app-id 'nm-connection-editor' float
riverctl rule-add -app-id 'org.kde.kcalc' float

# Media players. Keep both native Wayland and compatibility app IDs since the
# exact ID can differ with the toolkit/backend used at launch.
riverctl rule-add -app-id 'org.kde.haruna' float
riverctl rule-add -app-id 'haruna' float
riverctl rule-add -app-id 'vlc' float
riverctl rule-add -app-id 'org.videolan.VLC' float

# The GTK portal owns open/save/download file choosers for both browsers. Its
# dialogs sometimes have an empty or browser-generated title, so app ID is the
# reliable match. Both IDs are kept for GTK/backend version differences.
riverctl rule-add -app-id 'xdg-desktop-portal-gtk' float
riverctl rule-add -app-id 'org.freedesktop.impl.portal.desktop.gtk' float

# Browser-owned confirmation and file dialogs. Their titles can include a site,
# filename, or browser name, so use stable prefixes/suffixes where available.
for browser_id in 'firefox' 'org.mozilla.firefox' 'brave-origin' 'com.brave.Origin'
do
    for dialog_title in 'Open File*' 'Save File*' 'Save As*' 'Choose File*' 'Select File*' 'File Upload*' 'Download*' 'Opening *' '* wants to open'
    do
        riverctl rule-add -app-id "$browser_id" -title "$dialog_title" float
    done
done

# Portal/toolkit file choosers can have their own app ID instead of the
# browser's. These narrow title-prefix fallbacks cover those dialogs too.
riverctl rule-add -title 'Open File*' float
riverctl rule-add -title 'Save File*' float
riverctl rule-add -title 'Save As*' float
riverctl rule-add -title 'Choose File*' float
riverctl rule-add -title 'Select File*' float
riverctl rule-add -title 'File Upload*' float
riverctl rule-add -title '* wants to open' float

# -----------------------------------------------------------------------------
# Default layout
# -----------------------------------------------------------------------------

riverctl default-layout rivertile

# Tile edge-to-edge; River's borders separate adjacent views without
# wasting pixels around the outside of the usable area.
rivertile \
    -view-padding 0 \
    -outer-padding 0 &
